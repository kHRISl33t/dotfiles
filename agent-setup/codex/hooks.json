{
  "description": "tmux-aware macOS notifications for Codex CLI",
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/tmux-notify.sh\" input",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.codex/hooks/tmux-notify.sh\" done",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
